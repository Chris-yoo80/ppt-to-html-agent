  "css": ".scene-body.composed{word-break:keep-all}.cr-read{margin:0;font-size:14.5px;font-weight:700;color:var(--k-accent-dark);border-top:1px dashed var(--k-line);padding-top:7px}.cr-box{border:1px solid var(--k-line);border-radius:8px;padding:8px 12px;background:var(--k-panel)}.cr-box .k-kpi-value{font-size:36px}.cr-bars{display:flex;flex-direction:column;gap:7px}.cr-bar{display:grid;grid-template-columns:var(--lw,72px) minmax(0,1fr) var(--vw,60px);align-items:center;gap:10px;font-size:14.5px}.cr-bar>span{font-weight:700}.cr-bar>b{text-align:right;font-variant-numeric:tabular-nums}.cr-track{position:relative;height:var(--h,16px);background:var(--k-soft);border-radius:4px}.cr-track>i{display:block;height:100%;width:var(--v);background:var(--k-accent);border-radius:4px}.cr-track>i.muted{background:var(--k-muted)}.cr-track>i.warn{background:var(--k-warn)}.cr-track>u{position:absolute;top:-5px;bottom:-5px;left:var(--at);width:3px;background:var(--k-ink)}.cr-stack{display:flex;flex:none;gap:2px;height:22px;border-radius:5px;overflow:hidden}.cr-stack>i{display:block;width:var(--v);background:var(--c)}.cr-legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:13px;color:var(--k-muted)}.cr-legend span::before{content:\"\";display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;background:var(--c)}.cr-tiles{display:grid;grid-template-columns:repeat(var(--n,3),minmax(0,1fr));gap:8px}.cr-tile{display:flex;flex-direction:column;gap:1px;border:1px solid var(--k-line);border-top:3px solid var(--k-accent);border-radius:8px;padding:7px 11px;background:var(--k-panel);min-width:0}.cr-tile>span{font-size:13px;font-weight:700;color:var(--k-muted)}.cr-tile>b{font-size:24px;font-weight:800;line-height:1.15;color:var(--k-accent-dark);font-variant-numeric:tabular-nums}.cr-tile>small{font-size:12.5px;color:var(--k-muted)}.cr-tile.down{border-top-color:var(--k-bad)}.cr-tile.down>b{color:var(--k-bad)}.cr-warn{color:var(--k-warn)}.cr-cellnum{display:block;font-size:20px;font-weight:800;line-height:1.3}.k-tl-body .k-chips{margin-top:6px}.k-hero .k-rows>*{border-bottom-color:rgba(255,255,255,.3)}[data-scene=\"roadmap\"] .k-gantt{font-size:15px;column-gap:0;border-radius:8px;background-image:repeating-linear-gradient(90deg,var(--k-soft) 0 10%,transparent 10% 20%);background-size:calc(100% - 170px) 100%;background-position:right top;background-repeat:no-repeat}[data-scene=\"roadmap\"] .k-gantt-bar{height:36px;border-radius:18px;margin:0 3px}[data-scene=\"roadmap\"] .k-gantt-h{align-self:stretch;display:grid;place-items:center;margin:0 1px;padding:5px 0;border:0;border-radius:6px 6px 2px 2px;background:var(--k-ink);color:#fff}[data-scene=\"roadmap\"] .k-gantt-h small{display:block;font-size:11px;font-weight:700;color:var(--k-warn)}[data-scene=\"roadmap\"] .k-gantt-label{align-self:stretch;display:flex;flex-direction:column;justify-content:center;margin-right:10px;padding:2px 12px;border-radius:8px;background:var(--k-accent-dark);color:#fff}[data-scene=\"roadmap\"] .k-gantt-label small{display:block;font-size:12.5px;font-weight:600;color:rgba(255,255,255,.78)}[data-scene=\"investment\"] .k-table :is(th,td){padding:6px 10px}",
